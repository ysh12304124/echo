# 识境 Echo 后台配置示例。复制为 .env 并按本地部署调整。
# 所有变量以 ECHO_ 前缀映射到 app/providers Settings。

# provider 模式：mock（离线开发/测试，默认）| local（接本地模型服务）
ECHO_PROVIDER_MODE=mock

# 存储
ECHO_BLOB_STORAGE_PATH=./data/blobs
ECHO_DATABASE_URL=sqlite+aiosqlite:///./data/echo.db
ECHO_VECTOR_DB_PATH=./data/vectors.db

# 本地 LLM（OpenAI 兼容 /v1/chat/completions），用于事件/实体抽取与证据接地问答
ECHO_LLM_BASE_URL=http://localhost:8001/v1
ECHO_LLM_MODEL=qwen2.5
ECHO_LLM_API_KEY=not-needed

# 中文工作记忆 Embedding（Qwen3-Embedding-0.6B Q4_K_M，/v1/embeddings）
ECHO_EMBEDDING_BASE_URL=http://192.168.0.100:11434/v1
ECHO_EMBEDDING_MODEL=qwen3-embedding:0.6b-q4_k_m
ECHO_EMBEDDING_DIMENSION=1024
ECHO_EMBEDDING_API_KEY=not-needed
ECHO_EMBEDDING_QUERY_INSTRUCTION=Given a question about the user's work memories, retrieve evidence passages that directly answer the question

# Chinese-CLIP image/text embedding for keyframe retrieval
ECHO_VISUAL_EMBEDDING_BASE_URL=http://192.168.0.100:8300
ECHO_VISUAL_EMBEDDING_MODEL=chinese-clip-vit-base-patch16
ECHO_VISUAL_EMBEDDING_DIMENSION=512
ECHO_VISUAL_EMBEDDING_API_KEY=echo-internal-dev-token
ECHO_VISUAL_RETRIEVAL_ENABLED=true
ECHO_VISUAL_RETRIEVAL_CANDIDATES=10
ECHO_VISUAL_RETRIEVAL_TOP_K=3
ECHO_VISUAL_RETRIEVAL_MIN_SCORE=0.37
ECHO_VISUAL_RETRIEVAL_MEDIUM_SCORE=0.40
ECHO_VISUAL_RETRIEVAL_HIGH_SCORE=0.45

# Reranker scores remain advisory after candidate inclusion.
ECHO_RERANKER_MEDIUM_SCORE=0.65
ECHO_RERANKER_HIGH_SCORE=0.8

# 语音查询：低于最小时长直接提示过短，不发送 ASR
ECHO_VOICE_QUERY_MIN_SECONDS=0.5
ECHO_VOICE_QUERY_MAX_SECONDS=60
ECHO_ASR_MIN_AVG_LOGPROB=-1.0

# 算力服务(compute/，独立进程，同机 localhost 通信)：
# mock=complete 时本地直接回填假结果，不发真实网络请求(离线开发/测试默认)；
# http=真的 POST 给 ECHO_COMPUTE_BASE_URL，完成后由算力回调本服务。
# 语音转写(ASR)与空间重建(见 compute/analyze/space)都已迁到这里，详见
# docs/protocols/compute-service.md。
ECHO_COMPUTE_PROVIDER_MODE=mock
ECHO_COMPUTE_BASE_URL=http://127.0.0.1:8100
# 算力服务回调本服务时使用的地址(后台拼 callback_url 用)
ECHO_PUBLIC_CALLBACK_BASE_URL=http://127.0.0.1:8000
# /internal/callback/* 路由与算力服务之间的共享密钥，需与 compute/.env 的
# COMPUTE_INTERNAL_TOKEN 保持一致
ECHO_INTERNAL_TOKEN=echo-internal-dev-token

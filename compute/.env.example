# 识境 Echo 算力服务配置示例。复制为 .env 并按本地部署调整。
# 所有变量以 COMPUTE_ 前缀映射到 app/settings.py ComputeSettings。

COMPUTE_PORT=8100

# 需与 backend/.env 的 ECHO_INTERNAL_TOKEN 保持一致（回调时的共享密钥头校验）。
COMPUTE_INTERNAL_TOKEN=echo-internal-dev-token

# Whisper(OpenAI 兼容 /v1/audio/transcriptions)，供 analyze/audio.py 使用。
# 默认指向 compute/models/asr-whisper/start.sh 起的本机服务(默认端口 8081)；
# 如果部署到独立机器，改成对应机器的地址。
COMPUTE_ASR_BASE_URL=http://127.0.0.1:8081/v1
COMPUTE_ASR_MODEL=whisper-1
COMPUTE_ASR_API_KEY=not-needed
COMPUTE_ASR_LANGUAGE=zh

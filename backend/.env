ECHO_PROVIDER_MODE=local
ECHO_DATABASE_URL=sqlite+aiosqlite:///./data/echo.db
ECHO_BLOB_STORAGE_PATH=./data/blobs
ECHO_VECTOR_DB_PATH=./data/vectors.db

# LLM — Ollama gemma4:e2b
ECHO_LLM_BASE_URL=http://192.168.0.100:11434/v1
ECHO_LLM_MODEL=gemma4:e2b
ECHO_LLM_API_KEY=not-needed

# VLM — Ollama gemma4:e2b (multimodal)
ECHO_VLM_BASE_URL=http://192.168.0.100:11434/v1
ECHO_VLM_MODEL=gemma4:e2b
ECHO_VLM_API_KEY=not-needed

# ASR — Whisper on :8002
ECHO_ASR_BASE_URL=http://192.168.0.100:8002/v1
ECHO_ASR_MODEL=whisper-1
ECHO_ASR_API_KEY=not-needed
ECHO_ASR_LANGUAGE=zh

# Embedding — Ollama nomic-embed-text
ECHO_EMBEDDING_BASE_URL=http://192.168.0.100:11434/v1
ECHO_EMBEDDING_MODEL=nomic-embed-text:latest
ECHO_EMBEDDING_API_KEY=not-needed
